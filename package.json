{
  "name": "@addonport/website",
  "version": "0.1.0",
  "private": true,
  "description": "AddonPort installation guide and developer integration website.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AddonPort/website.git"
  },
  "homepage": "https://addonport.dev",
  "bugs": {
    "url": "https://github.com/AddonPort/website/issues"
  },
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "deploy": "pnpm build && wrangler deploy",
    "dev": "next dev --hostname 127.0.0.1 --port 4173",
    "format": "biome format --write .",
    "lint": "biome check .",
    "preview": "pnpm build && wrangler dev",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "lucide-react": "^1.32.0",
    "next": "16.3.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.124.0"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
